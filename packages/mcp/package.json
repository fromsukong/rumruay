{
  "name": "@rumruay/mcp",
  "version": "0.1.0",
  "description": "rumruay MCP server: personal finance tools for AI agents (ledger, budgets, net worth).",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "rumruay": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node ./dist/index.js",
    "test": "tsup && vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test && npm run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@rumruay/core": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "finance",
    "personal-finance"
  ],
  "publishConfig": {
    "access": "public"
  }
}
